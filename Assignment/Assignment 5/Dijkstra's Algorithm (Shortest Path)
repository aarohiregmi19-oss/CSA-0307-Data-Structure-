
#include <stdio.h>

#define V 6
#define INF 99999

int main() {
    int graph[V][V] = {
        {0, 7, 9, 0, 0, 14},
        {7, 0, 10, 15, 0, 0},
        {9, 10, 0, 11, 0, 2},
        {0, 15, 11, 0, 6, 0},
        {0, 0, 0, 6, 0, 9},
        {14, 0, 2, 0, 9, 0}
    };

    int dist[V], done[V] = {0}, prev[V];
    int i, j, u, min, source = 0, target = 4;

    for (i = 0; i < V; i++) {
        dist[i] = INF;
        prev[i] = -1;
    }

    dist[source] = 0;

    for (i = 0; i < V - 1; i++) {
        min = INF;
        u = -1;

        for (j = 0; j < V; j++) {
            if (!done[j] && dist[j] < min) {
                min = dist[j];
                u = j;
            }
        }

        if (u == -1)
            break;

        done[u] = 1;

        for (j = 0; j < V; j++) {
            if (graph[u][j] > 0 && !done[j] &&
                dist[u] != INF &&
                dist[u] + graph[u][j] < dist[j]) {

                dist[j] = dist[u] + graph[u][j];
                prev[j] = u;
            }
        }
    }

    printf("Shortest distances from vertex 0:\n");

    for (i = 0; i < V; i++) {
        if (dist[i] == INF)
            printf("Vertex %d = Unreachable\n", i);
        else
            printf("Vertex %d = %d\n", i, dist[i]);
    }

    if (dist[target] == INF) {
        printf("Destination is unreachable.\n");
    } else {
        int path[V], count = 0;
        int current = target;

        while (current != -1) {
            path[count++] = current;
            current = prev[current];
        }

        printf("Shortest route: ");

        for (i = count - 1; i >= 0; i--) {
            printf("%d", path[i]);
            if (i > 0)
                printf(" -> ");
        }

        printf("\nMinimum distance = %d\n", dist[target]);
    }

    return 0;
}
