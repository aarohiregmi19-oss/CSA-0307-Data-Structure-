
#include <stdio.h>

#define V 5
#define INF 99999

int main() {
    int graph[V][V] = {
        {0, 2, 0, 6, 0},
        {2, 0, 3, 8, 5},
        {0, 3, 0, 0, 7},
        {6, 8, 0, 0, 9},
        {0, 5, 7, 9, 0}
    };

    int key[V], parent[V], inMST[V] = {0};
    int i, j, u, min, total = 0;

    for (i = 0; i < V; i++) {
        key[i] = INF;
        parent[i] = -1;
    }

    key[0] = 0;

    for (i = 0; i < V; i++) {
        min = INF;
        u = -1;

        for (j = 0; j < V; j++) {
            if (!inMST[j] && key[j] < min) {
                min = key[j];
                u = j;
            }
        }

        if (u == -1)
            break;

        inMST[u] = 1;
        total += key[u];

        for (j = 0; j < V; j++) {
            if (graph[u][j] > 0 &&
                !inMST[j] && graph[u][j] < key[j]) {
                key[j] = graph[u][j];
                parent[j] = u;
            }
        }
    }

    printf("Minimum Spanning Tree:\n");

    for (i = 1; i < V; i++) {
        if (parent[i] != -1)
            printf("%d - %d (%d)\n",
                   parent[i], i, graph[i][parent[i]]);
    }

    printf("Total cost = %d\n", total);

    return 0;
}
