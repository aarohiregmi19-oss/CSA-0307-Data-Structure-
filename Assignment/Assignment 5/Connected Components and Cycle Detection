
#include <stdio.h>

#define MAX 20

int graph[MAX][MAX];
int visited[MAX];
int n;

int dfs(int vertex, int parent) {
    visited[vertex] = 1;

    for (int i = 0; i < n; i++) {
        if (graph[vertex][i]) {
            if (!visited[i]) {
                if (dfs(i, vertex))
                    return 1;
            }
            else if (i != parent) {
                return 1;
            }
        }
    }
    return 0;
}

int main() {
    int e, u, v;
    int components = 0;
    int cycle = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &e);

    printf("Enter edges:\n");

    for (int i = 0; i < e; i++) {
        scanf("%d %d", &u, &v);
        graph[u][v] = 1;
        graph[v][u] = 1;
    }

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            components++;

            if (dfs(i, -1))
                cycle = 1;
        }
    }

    printf("\nConnected Components = %d\n", components);

    if (cycle)
        printf("Cycle detected in the graph.\n");
    else
        printf("No cycle in the graph.\n");

    return 0;
}
