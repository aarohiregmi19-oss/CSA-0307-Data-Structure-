
#include <stdio.h>
#include <stdlib.h>

typedef struct Order
{
    unsigned int id;
    int restaurant;
    int amount;
    long promised;

    int heap_pos;

    struct Order *next;

} Order;

int main()
{
    Order o;

    o.id = 101;
    o.restaurant = 5;
    o.amount = 250;
    o.promised = 30;
    o.heap_pos = 0;
    o.next = NULL;

    printf("Order ID: %u\n", o.id);
    printf("Restaurant: %d\n", o.restaurant);
    printf("Amount: %d\n", o.amount);
    printf("Promised Time: %ld minutes\n", o.promised);

    return 0;
}
